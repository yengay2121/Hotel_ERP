@model HotelERP.Models.Payment
@{
    ViewData["Title"] = "Ödeme Kaydını Sil";
}

<div class="row mb-4">
    <div class="col-md-6 mx-auto">
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary mb-3"><i class="bi bi-arrow-left"></i> Geri Dön</a>
        <h1 class="h3 fw-bold text-dark"><i class="bi bi-exclamation-triangle-fill text-danger"></i> Ödeme Kaydını Sil</h1>
        <p class="text-muted">Aşağıdaki ödeme kaydını sistemden silmek istediğinizden emin misiniz? Bu işlem geri alınamaz.</p>
    </div>
</div>

<div class="row">
    <div class="col-md-6 mx-auto">
        <div class="card border border-danger">
            <div class="card-body p-4">
                <h4 class="fw-bold text-danger mb-3">Ödeme #@Model.Id</h4>
                
                <div class="detail-item">
                    <span class="detail-label d-block">Müşteri</span>
                    <span class="detail-val">@Model.Reservation?.Customer?.FirstName @Model.Reservation?.Customer?.LastName</span>
                </div>
                <div class="detail-item">
                    <span class="detail-label d-block">Ödeme Tarihi</span>
                    <span class="detail-val">@Model.PaymentDate.ToShortDateString()</span>
                </div>
                <div class="detail-item mb-4">
                    <span class="detail-label d-block">Tutar</span>
                    <span class="detail-val fw-bold text-danger">@Model.Amount.ToString("N2") TL</span>
                </div>

                <div class="alert alert-warning mb-4" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i>
                    <strong>ERP Muhasebe Uyarısı:</strong> Ödeme kaydının silinmesi, ilgili rezervasyonun bakiyesini artıracak ve toplam ciro istatistiklerini düşürecektir.
                </div>

                <form asp-action="Delete">
                    <input type="hidden" asp-for="Id" />
                    <button type="submit" class="btn btn-danger px-4 fw-semibold">Evet, Sil</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">İptal</a>
                </form>
            </div>
        </div>
    </div>
</div>
