@model HotelERP.Models.Payment
@{
    ViewData["Title"] = "Yeni Ödeme Ekle";
}

<div class="row mb-4">
    <div class="col-md-6 mx-auto">
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary mb-3"><i class="bi bi-arrow-left"></i> Geri Dön</a>
        <h1 class="h3 fw-bold text-dark"><i class="bi bi-plus-circle-fill text-warning"></i> Ödeme Kaydı Oluştur</h1>
        <p class="text-muted">Rezervasyon ödemesi tahsil etmek için bilgileri doldurun.</p>
    </div>
</div>

<div class="row">
    <div class="col-md-6 mx-auto">
        <div class="card">
            <div class="card-body p-4">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    
                    <div class="mb-3">
                        <label asp-for="ReservationId" class="form-label">Rezervasyon Seçin</label>
                        <select asp-for="ReservationId" class="form-select" asp-items="ViewBag.ReservationId">
                            <option value="">-- Ödeme Yapılacak Rezervasyonu Seçin --</option>
                        </select>
                        <span asp-validation-for="ReservationId" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Amount" class="form-label"></label>
                        <div class="input-group">
                            <input asp-for="Amount" class="form-control" type="number" step="0.01" placeholder="0.00" />
                            <span class="input-group-text">TL</span>
                        </div>
                        <span asp-validation-for="Amount" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PaymentDate" class="form-label"></label>
                        <input asp-for="PaymentDate" class="form-control" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="PaymentDate" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="PaymentMethod" class="form-label"></label>
                            <select asp-for="PaymentMethod" class="form-select" asp-items="Html.GetEnumSelectList<HotelERP.Models.PaymentMethod>()"></select>
                            <span asp-validation-for="PaymentMethod" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Status" class="form-label"></label>
                            <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<HotelERP.Models.PaymentStatus>()"></select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-warning px-4 text-white fw-semibold">Kaydet</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">İptal</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
