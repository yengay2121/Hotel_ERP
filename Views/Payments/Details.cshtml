@model HotelERP.Models.Payment
@{
    ViewData["Title"] = "Ödeme Detayları";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary mb-3"><i class="bi bi-arrow-left"></i> Ödeme Listesine Dön</a>
        <h1 class="h3 fw-bold text-dark mb-1">Ödeme #@Model.Id</h1>
        <p class="text-muted mb-0">Finansal Ödeme Detayları</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning text-white fw-semibold"><i class="bi bi-pencil"></i> Düzenle</a>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger"><i class="bi bi-trash"></i> Sil</a>
    </div>
</div>

<div class="row">
    <div class="col-md-6 mx-auto">
        <div class="card">
            <div class="card-header bg-white">
                <h5 class="mb-0 fw-bold"><i class="bi bi-receipt text-primary"></i> Ödeme Makbuzu</h5>
            </div>
            <div class="card-body">
                <div class="detail-item">
                    <span class="detail-label d-block">Ödeme Numarası (ID)</span>
                    <span class="detail-val">#@Model.Id</span>
                </div>
                <div class="detail-item">
                    <span class="detail-label d-block">İlişkili Rezervasyon</span>
                    <span class="detail-val">
                        <a asp-controller="Reservations" asp-action="Details" asp-route-id="@Model.ReservationId" class="text-decoration-none">
                            Rezervasyon #@Model.ReservationId
                        </a>
                    </span>
                </div>
                <div class="detail-item">
                    <span class="detail-label d-block">Müşteri</span>
                    <span class="detail-val">@Model.Reservation?.Customer?.FirstName @Model.Reservation?.Customer?.LastName</span>
                </div>
                <div class="detail-item">
                    <span class="detail-label d-block">Tesis ve Oda</span>
                    <span class="detail-val">@Model.Reservation?.Room?.Hotel?.Name - Oda @Model.Reservation?.Room?.RoomNumber</span>
                </div>
                <div class="detail-item">
                    <span class="detail-label d-block">Ödeme Tarihi</span>
                    <span class="detail-val">@Model.PaymentDate.ToLongDateString()</span>
                </div>
                <div class="detail-item">
                    <span class="detail-label d-block">Ödeme Yöntemi</span>
                    <span class="detail-val">@Model.PaymentMethod</span>
                </div>
                <div class="detail-item">
                    <span class="detail-label d-block">Tutar</span>
                    <span class="detail-val fw-bold text-success fs-5">@Model.Amount.ToString("N2") TL</span>
                </div>
                <div class="detail-item">
                    <span class="detail-label d-block">Ödeme Durumu</span>
                    <span class="detail-val">
                        @if (Model.Status == HotelERP.Models.PaymentStatus.Paid) {
                            <span class="badge bg-success">Ödendi</span>
                        } else if (Model.Status == HotelERP.Models.PaymentStatus.Pending) {
                            <span class="badge bg-warning text-dark">Beklemede</span>
                        } else {
                            <span class="badge bg-danger">İade Edildi</span>
                        }
                    </span>
                </div>
            </div>
        </div>
    </div>
</div>
