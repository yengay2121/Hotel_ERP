@model IEnumerable<HotelERP.Models.Room>
@{
    ViewData["Title"] = "Odalar";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 fw-bold text-dark mb-1"><i class="bi bi-door-open text-warning"></i> Oda Yönetimi</h1>
        <p class="text-muted mb-0">Otellerinizdeki tüm odaları görüntüleyin, oda tiplerini ve fiyatlarını düzenleyin.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary d-flex align-items-center gap-2">
        <i class="bi bi-plus-lg"></i> Yeni Oda Tanımla
    </a>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Otel</th>
                        <th>Oda No</th>
                        <th>Oda Tipi</th>
                        <th>Gecelik Fiyat</th>
                        <th>Durum</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model) {
                        <tr>
                            <td>
                                <strong class="text-dark">@item.Hotel?.Name</strong>
                            </td>
                            <td class="fw-semibold">Oda @item.RoomNumber</td>
                            <td>@item.RoomType</td>
                            <td class="fw-bold">@item.PricePerNight.ToString("N2") TL</td>
                            <td>
                                @if (item.IsAvailable) {
                                    <span class="badge bg-success"><i class="bi bi-check-circle"></i> Müsait</span>
                                } else {
                                    <span class="badge bg-danger"><i class="bi bi-x-circle"></i> Dolu / Rezerve</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary" title="Düzenle"><i class="bi bi-pencil"></i></a>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info text-dark" title="Detaylar"><i class="bi bi-eye"></i></a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger" title="Sil"><i class="bi bi-trash"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
