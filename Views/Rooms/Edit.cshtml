@model HotelERP.Models.Room
@{
    ViewData["Title"] = "Odayı Düzenle";
}

<div class="row mb-4">
    <div class="col-md-6 mx-auto">
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary mb-3"><i class="bi bi-arrow-left"></i> Geri Dön</a>
        <h1 class="h3 fw-bold text-dark"><i class="bi bi-pencil-square text-warning"></i> Oda Bilgilerini Güncelle</h1>
        <p class="text-muted">Oda tipini, durumunu ve gecelik ücretini güncelleyin.</p>
    </div>
</div>

<div class="row">
    <div class="col-md-6 mx-auto">
        <div class="card">
            <div class="card-body p-4">
                <form asp-action="Edit">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="Id" />
                    
                    <div class="mb-3">
                        <label asp-for="HotelId" class="form-label"></label>
                        <select asp-for="HotelId" class="form-select" asp-items="ViewBag.HotelId"></select>
                        <span asp-validation-for="HotelId" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="RoomNumber" class="form-label"></label>
                            <input asp-for="RoomNumber" class="form-control" />
                            <span asp-validation-for="RoomNumber" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="RoomType" class="form-label"></label>
                            <select asp-for="RoomType" class="form-select" asp-items="Html.GetEnumSelectList<HotelERP.Models.RoomType>()"></select>
                            <span asp-validation-for="RoomType" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PricePerNight" class="form-label"></label>
                        <div class="input-group">
                            <input asp-for="PricePerNight" class="form-control" type="number" step="0.01" />
                            <span class="input-group-text">TL</span>
                        </div>
                        <span asp-validation-for="PricePerNight" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" asp-for="IsAvailable">
                            <label class="form-check-label fw-semibold" asp-for="IsAvailable">Oda Müsait mi?</label>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-warning px-4 text-white fw-semibold">Güncelle</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">İptal</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
