@model IEnumerable<HotelERP.Models.Hotel>
@{
    ViewData["Title"] = "Oteller";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 fw-bold text-dark mb-1"><i class="bi bi-building text-warning"></i> Otel Yönetimi</h1>
        <p class="text-muted mb-0">Tüm otelleri listeleyin, güncelleyin ve yenisini tanımlayın.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary d-flex align-items-center gap-2">
        <i class="bi bi-plus-lg"></i> Yeni Otel Ekle
    </a>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Otel Adı</th>
                        <th>Yıldız</th>
                        <th>Adres</th>
                        <th>İletişim</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model) {
                        <tr>
                            <td class="fw-bold text-dark">
                                <a asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none text-dark">@item.Name</a>
                            </td>
                            <td>
                                @for(int i = 0; i < item.Stars; i++) {
                                    <i class="bi bi-star-fill text-warning"></i>
                                }
                                @for(int i = item.Stars; i < 5; i++) {
                                    <i class="bi bi-star text-muted"></i>
                                }
                            </td>
                            <td>@item.Address</td>
                            <td>
                                <div><i class="bi bi-telephone text-muted"></i> @item.Phone</div>
                                <div><i class="bi bi-envelope text-muted"></i> @item.Email</div>
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary" title="Düzenle"><i class="bi bi-pencil"></i></a>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info text-dark" title="Detaylar"><i class="bi bi-eye"></i></a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger" title="Sil"><i class="bi bi-trash"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
