@model HotelERP.Models.Hotel
@{
    ViewData["Title"] = "Oteli Sil";
}

<div class="row mb-4">
    <div class="col-md-6 mx-auto">
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary mb-3"><i class="bi bi-arrow-left"></i> Geri Dön</a>
        <h1 class="h3 fw-bold text-dark"><i class="bi bi-exclamation-triangle-fill text-danger"></i> Oteli Sil</h1>
        <p class="text-muted">Aşağıdaki oteli silmek istediğinizden emin misiniz? Bu işlem geri alınamaz.</p>
    </div>
</div>

<div class="row">
    <div class="col-md-6 mx-auto">
        <div class="card border border-danger">
            <div class="card-body p-4">
                <h4 class="fw-bold text-danger mb-3">@Model.Name</h4>
                
                <div class="detail-item">
                    <span class="detail-label d-block">Adres</span>
                    <span class="detail-val">@Model.Address</span>
                </div>
                <div class="detail-item">
                    <span class="detail-label d-block">Telefon</span>
                    <span class="detail-val">@Model.Phone</span>
                </div>
                <div class="detail-item mb-4">
                    <span class="detail-label d-block">E-posta</span>
                    <span class="detail-val">@Model.Email</span>
                </div>

                <div class="alert alert-warning d-flex align-items-center gap-2 mb-4" role="alert">
                    <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                    <div>
                        <strong>Dikkat:</strong> Bu oteli silmek, otele ait tüm oda ve personel kayıtlarını da silecektir!
                    </div>
                </div>

                <form asp-action="Delete">
                    <input type="hidden" asp-for="Id" />
                    <button type="submit" class="btn btn-danger px-4 fw-semibold">Evet, Sil</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">İptal</a>
                </form>
            </div>
        </div>
    </div>
</div>
