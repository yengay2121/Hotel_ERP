@model IEnumerable<HotelERP.Models.Reservation>
@{
    ViewData["Title"] = "Rezervasyonlar";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 fw-bold text-dark mb-1"><i class="bi bi-calendar-check text-warning"></i> Rezervasyon Yönetimi</h1>
        <p class="text-muted mb-0">Müşterilerin oda rezervasyonlarını takip edin, durumlarını güncelleyin ve ödemelerini izleyin.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary d-flex align-items-center gap-2">
        <i class="bi bi-plus-lg"></i> Yeni Rezervasyon Al
    </a>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Müşteri</th>
                        <th>Otel & Oda</th>
                        <th>Giriş / Çıkış Tarihi</th>
                        <th>Toplam Tutar</th>
                        <th>Durum</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model) {
                        <tr>
                            <td>
                                <div class="fw-bold text-dark">
                                    <a asp-controller="Customers" asp-action="Details" asp-route-id="@item.CustomerId" class="text-decoration-none text-dark">@item.Customer?.FirstName @item.Customer?.LastName</a>
                                </div>
                                <small class="text-muted">TC: @item.Customer?.NationalId</small>
                            </td>
                            <td>
                                <div>@item.Room?.Hotel?.Name</div>
                                <span class="badge bg-secondary">Oda @item.Room?.RoomNumber (@item.Room?.RoomType)</span>
                            </td>
                            <td>
                                <div>Giriş: @item.CheckInDate.ToShortDateString()</div>
                                <div>Çıkış: @item.CheckOutDate.ToShortDateString()</div>
                            </td>
                            <td class="fw-bold text-success">@item.TotalPrice.ToString("N2") TL</td>
                            <td>
                                @if (item.Status == HotelERP.Models.ReservationStatus.Confirmed) {
                                    <span class="badge bg-success">Onaylandı</span>
                                } else if (item.Status == HotelERP.Models.ReservationStatus.Pending) {
                                    <span class="badge bg-warning text-dark">Beklemede</span>
                                } else if (item.Status == HotelERP.Models.ReservationStatus.Cancelled) {
                                    <span class="badge bg-danger">İptal Edildi</span>
                                } else {
                                    <span class="badge bg-info text-dark">Tamamlandı</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary" title="Düzenle"><i class="bi bi-pencil"></i></a>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info text-dark" title="Detaylar"><i class="bi bi-eye"></i></a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger" title="Sil"><i class="bi bi-trash"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
