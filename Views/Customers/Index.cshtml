@model IEnumerable<HotelERP.Models.Customer>
@{
    ViewData["Title"] = "Müşteriler";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 fw-bold text-dark mb-1"><i class="bi bi-people text-warning"></i> Müşteri Yönetimi</h1>
        <p class="text-muted mb-0">Müşteri veritabanınızı yönetin, iletişim bilgilerini ve geçmiş rezervasyonlarını takip edin.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary d-flex align-items-center gap-2">
        <i class="bi bi-plus-lg"></i> Yeni Müşteri Kaydet
    </a>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Adı Soyadı</th>
                        <th>Kimlik / Pasaport</th>
                        <th>Telefon</th>
                        <th>E-posta</th>
                        <th>Adres</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model) {
                        <tr>
                            <td class="fw-bold text-dark">
                                <a asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none text-dark">@item.FirstName @item.LastName</a>
                            </td>
                            <td><code>@item.NationalId</code></td>
                            <td>@item.Phone</td>
                            <td>@item.Email</td>
                            <td>@item.Address</td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary" title="Düzenle"><i class="bi bi-pencil"></i></a>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info text-dark" title="Detaylar"><i class="bi bi-eye"></i></a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger" title="Sil"><i class="bi bi-trash"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
